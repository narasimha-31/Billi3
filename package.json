{
	"name": "billie",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"verify": "npm run check && npm test && npm run build",
		"db:push": "node --env-file=.env migrate.js",
		"test:db": "node --env-file=.env node_modules/vitest/vitest.mjs run --dir supabase/tests",
		"eval:ai": "node --env-file=.env node_modules/vitest/vitest.mjs run --dir evals"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/leaflet": "^1.9.20",
		"supabase": "^2.120.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@number-flow/svelte": "^0.4.2",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.117.3",
		"fflate": "0.8.3",
		"leaflet": "1.9.4",
		"motion": "^14.2.0",
		"pdfjs-dist": "6.4.299",
		"uqr": "0.1.3"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		}
	}
}
